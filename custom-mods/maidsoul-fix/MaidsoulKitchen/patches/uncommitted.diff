diff --git a/src/main/java/com/github/wallev/maidsoulkitchen/task/cook/youkaishomecoming/YhFluidItem.java b/src/main/java/com/github/wallev/maidsoulkitchen/task/cook/youkaishomecoming/YhFluidItem.java
new file mode 100644
index 0000000..936b26e
--- /dev/null
+++ b/src/main/java/com/github/wallev/maidsoulkitchen/task/cook/youkaishomecoming/YhFluidItem.java
@@ -0,0 +1,39 @@
+package com.github.wallev.maidsoulkitchen.task.cook.youkaishomecoming;
+
+import dev.xkmc.youkaishomecoming.content.item.fluid.IYHFluidHolder;
+import dev.xkmc.youkaishomecoming.content.item.fluid.IYHSake;
+import dev.xkmc.youkaishomecoming.content.item.fluid.SakeFluid;
+import dev.xkmc.youkaishomecoming.content.item.fluid.YHFluid;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.material.Fluid;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * 妖归 4.x 里瓶装流体分成了两套接口：老的 {@link IYHSake}（YHSake 枚举，对应 {@link SakeFluid}）
+ * 和新的 {@link IYHFluidHolder}（BottledFluid，对应 {@link YHFluid}）。
+ * 两者成员完全一致却没有公共父类，这里统一成一个视图。
+ * <p>
+ * 注意不要再用 {@code SakeBottleItem#getFluid()} 反查：它声明返回 {@link YHFluid}，
+ * 但清酒实际拿到的是 {@link SakeFluid}，取出来就会 ClassCastException。
+ * 从流体注册表反过来找才是安全的。
+ *
+ * @param container 装这种流体要用的空容器（玻璃瓶、竹筒等）
+ * @param stack     装满之后得到的成品物品
+ * @param amount    一个容器能装走多少 mB
+ */
+public record YhFluidItem(Item container, ItemStack stack, int amount) {
+
+    @Nullable
+    public static YhFluidItem of(Fluid fluid) {
+        if (fluid instanceof SakeFluid sakeFluid) {
+            IYHSake type = sakeFluid.type;
+            return new YhFluidItem(type.getContainer(), type.asStack(1), type.amount());
+        }
+        if (fluid instanceof YHFluid yhFluid) {
+            IYHFluidHolder type = yhFluid.type;
+            return new YhFluidItem(type.getContainer(), type.asStack(1), type.amount());
+        }
+        return null;
+    }
+}
