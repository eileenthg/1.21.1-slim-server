 package toni.distractionfreerecipes;
 
+import org.apache.logging.log4j.LogManager;
 import org.objectweb.asm.tree.ClassNode;
 import org.spongepowered.asm.mixin.extensibility.IMixinConfigPlugin;
 import org.spongepowered.asm.mixin.extensibility.IMixinInfo;
+import org.spongepowered.asm.service.MixinService;
 import toni.lib.utils.PlatformUtils;
 
 import java.util.List;
 import java.util.Set;
 
 public class MixinPlugin implements IMixinConfigPlugin {
+    #if AFTER_21_1
+    private Boolean modernJei;
+
+    // The 1.21.1 JEI mixins target the overlay layout introduced in JEI 19.40; skip them on older JEI.
+    private boolean isModernJei() {
+        if (modernJei == null) {
+            try {
+                MixinService.getService().getBytecodeProvider().getClassNode("mezz.jei.gui.overlay.ingredients.IIngredientListOverlayContents");
+                modernJei = true;
+            } catch (Exception e) {
+                modernJei = false;
+                LogManager.getLogger("DistractionFreeRecipes").warn("JEI is older than 19.40; Distraction Free Recipes' JEI support is disabled. Update JEI to use it.");
+            }
+        }
+        return modernJei;
+    }
+    #endif
 
     @Override
     public void onLoad(String mixinPackage) {
@@ -31,6 +50,11 @@ public class MixinPlugin implements IMixinConfigPlugin {
         if (mixinClassName.contains("JEI") && (!PlatformUtils.isModLoaded("jei") || PlatformUtils.isModLoaded("emi")))
             return false;
 
+        #if AFTER_21_1
+        if (mixinClassName.contains("JEI") && !isModernJei())
+            return false;
+        #endif
+
         return true;
     }
 
