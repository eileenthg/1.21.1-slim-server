+// JEI 19.40+ removed IngredientGridWithNavigation$UserInputHandler; the grid's input handler is now
+// created by IIngredientListOverlayContents, so it is wrapped where IngredientListOverlay builds it.
+@Mixin(value = IngredientListOverlay.class #if FORGE , remap = false #endif)
+public class JEICombinedInputHandlerMixin {
+    @WrapOperation(method = "createInputHandler", at = @At(value = "INVOKE", target = "Lmezz/jei/gui/overlay/ingredients/IIngredientListOverlayContents;createInputHandler()Lmezz/jei/common/input/IUserInputHandler;"))
+    private IUserInputHandler distractionFreeRecipes$createInputHandler(IIngredientListOverlayContents instance, Operation<IUserInputHandler> original) {
+        return new JEIInputHandler(original.call(instance), (JEIAccessor) this);
+    }
+}
+#else
 import com.mojang.blaze3d.platform.InputConstants;
 import mezz.jei.common.Internal;
 import mezz.jei.common.input.IInternalKeyMappings;
@@ -47,3 +68,4 @@ public class JEICombinedInputHandlerMixin {
         }
     }
 }
