--- /dev/null
+++ b/src/main/java/toni/distractionfreerecipes/foundation/JEIInputHandler.java
@@ -0,0 +1,74 @@
+package toni.distractionfreerecipes.foundation;
+
+#if AFTER_21_1
+import com.mojang.blaze3d.platform.InputConstants;
+import mezz.jei.common.input.IInternalKeyMappings;
+import mezz.jei.common.input.IUserInputHandler;
+import mezz.jei.common.input.UserInput;
+import net.minecraft.client.gui.screens.Screen;
+import toni.distractionfreerecipes.foundation.config.AllConfigs;
+
+import java.util.Optional;
+
+/**
+ * Wraps the ingredient grid's input handler. Handles the Show/Hide Recipes buttons and swallows
+ * input aimed at the grid while it is hidden, so invisible ingredients can't be clicked or paged.
+ * Replaces the pre-19.40 mixin on IngredientGridWithNavigation$UserInputHandler.
+ */
+public class JEIInputHandler implements IUserInputHandler {
+    private final IUserInputHandler delegate;
+    private final JEIAccessor overlay;
+
+    public JEIInputHandler(IUserInputHandler delegate, JEIAccessor overlay) {
+        this.delegate = delegate;
+        this.overlay = overlay;
+    }
+
+    @Override
+    public Optional<IUserInputHandler> handleUserInput(Screen screen, UserInput input, IInternalKeyMappings keyBindings) {
+        if (input.getKey().getType() == InputConstants.Type.MOUSE) {
+            int mouseX = (int) input.getMouseX();
+            int mouseY = (int) input.getMouseY();
+            boolean leftClick = input.getKey().getValue() == InputConstants.MOUSE_BUTTON_LEFT;
+            var config = AllConfigs.client();
+
+            if (!config.enabled.get()) {
+                if (leftClick && config.showToggleButton.get() && GuiHelpers.getHideRecipesBounds().contains(mouseX, mouseY)) {
+                    if (!input.isSimulate())
+                        config.enabled.set(true);
+                    return Optional.of(this);
+                }
+            } else if (overlay.distractionFreeRecipes$isSearchEmpty()) {
+                if (leftClick && config.showToggleButton.get() && GuiHelpers.getShowRecipesBounds().contains(mouseX, mouseY)) {
+                    if (!input.isSimulate())
+                        config.enabled.set(false);
+                    return Optional.of(this);
+                }
+                if (GuiHelpers.searchBounds.contains(mouseX, mouseY))
+                    return Optional.of(this);
+            }
+        }
+
+        return delegate.handleUserInput(screen, input, keyBindings);
+    }
+
+    @Override
+    public void unfocus() {
+        delegate.unfocus();
+    }
+
+    @Override
+    public Optional<IUserInputHandler> handleMouseScrolled(double mouseX, double mouseY, double scrollDeltaX, double scrollDeltaY) {
+        if (overlay.distractionFreeRecipes$isHidden() && GuiHelpers.searchBounds.contains((int) mouseX, (int) mouseY))
+            return Optional.of(this);
+        return delegate.handleMouseScrolled(mouseX, mouseY, scrollDeltaX, scrollDeltaY);
+    }
+
+    @Override
+    public Optional<IUserInputHandler> handleMouseDragged(double mouseX, double mouseY, InputConstants.Key mouseKey, double dragX, double dragY) {
+        if (overlay.distractionFreeRecipes$isHidden())
+            return Optional.empty();
+        return delegate.handleMouseDragged(mouseX, mouseY, mouseKey, dragX, dragY);
+    }
+}
+#endif
