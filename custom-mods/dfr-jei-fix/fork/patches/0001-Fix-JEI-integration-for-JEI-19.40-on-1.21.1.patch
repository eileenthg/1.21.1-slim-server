--- a/src/main/java/toni/distractionfreerecipes/mixins/JEIIngredientListOverlayMixin.java
+++ b/src/main/java/toni/distractionfreerecipes/mixins/JEIIngredientListOverlayMixin.java
@@ -1,5 +1,99 @@
 package toni.distractionfreerecipes.mixins;
 
+#if AFTER_21_1
+import com.llamalad7.mixinextras.injector.v2.WrapWithCondition;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import mezz.jei.gui.input.GuiTextFieldFilter;
+import mezz.jei.gui.overlay.IngredientListOverlay;
+import mezz.jei.gui.overlay.ingredients.IIngredientListOverlayContents;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphics;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+import toni.distractionfreerecipes.foundation.GuiHelpers;
+import toni.distractionfreerecipes.foundation.JEIAccessor;
+import toni.distractionfreerecipes.foundation.config.AllConfigs;
+
+import java.util.stream.Stream;
+
+// JEI 19.40+ moved the ingredient grid behind IIngredientListOverlayContents and split drawing into
+// drawBackground / drawForeground / drawTooltips / drawOnForeground. Every call into the contents is
+// gated, so the search bar, config button and lookup history keep working while the grid is hidden.
+@Mixin(value = IngredientListOverlay.class #if FORGE , remap = false #endif)
+public abstract class JEIIngredientListOverlayMixin implements JEIAccessor {
+    @Shadow @Final private GuiTextFieldFilter searchField;
+    @Shadow @Final private IIngredientListOverlayContents contents;
+
+    @Override
+    public boolean distractionFreeRecipes$isSearchEmpty() {
+        return searchField.getValue().isEmpty();
+    }
+
+    @Override
+    public boolean distractionFreeRecipes$isHidden() {
+        return AllConfigs.client().enabled.get() && distractionFreeRecipes$isSearchEmpty();
+    }
+
+    @WrapWithCondition(method = "drawBackground", at = @At(value = "INVOKE", target = "Lmezz/jei/gui/overlay/ingredients/IIngredientListOverlayContents;drawBackground(Lnet/minecraft/client/gui/GuiGraphics;)V"))
+    private boolean distractionFreeRecipes$drawBackground(IIngredientListOverlayContents instance, GuiGraphics guiGraphics) {
+        var area = contents.getBackgroundArea();
+        GuiHelpers.searchBounds.setPosition(area.getX(), area.getY());
+        GuiHelpers.searchBounds.setWidth(area.getWidth());
+        GuiHelpers.searchBounds.setHeight(area.getHeight());
+        return !distractionFreeRecipes$isHidden();
+    }
+
+    @WrapWithCondition(method = "drawForeground", at = @At(value = "INVOKE", target = "Lmezz/jei/gui/overlay/ingredients/IIngredientListOverlayContents;drawForeground(Lnet/minecraft/client/Minecraft;Lnet/minecraft/client/gui/GuiGraphics;IIF)V"))
+    private boolean distractionFreeRecipes$drawForeground(IIngredientListOverlayContents instance, Minecraft minecraft, GuiGraphics guiGraphics, int mouseX, int mouseY, float partialTicks) {
+        if (distractionFreeRecipes$isHidden()) {
+            GuiHelpers.drawShowRecipesButton(guiGraphics);
+            return false;
+        }
+        return true;
+    }
+
+    @Inject(method = "drawForeground", at = @At("TAIL"))
+    private void distractionFreeRecipes$drawHideButton(Minecraft minecraft, GuiGraphics guiGraphics, int mouseX, int mouseY, float partialTicks, CallbackInfo ci) {
+        var config = AllConfigs.client();
+        if (!config.enabled.get() && config.showToggleButton.get() && ((IngredientListOverlay) (Object) this).isListDisplayed())
+            GuiHelpers.drawHideRecipesButton(guiGraphics);
+    }
+
+    @WrapWithCondition(method = "drawTooltips", at = @At(value = "INVOKE", target = "Lmezz/jei/gui/overlay/ingredients/IIngredientListOverlayContents;drawTooltips(Lnet/minecraft/client/Minecraft;Lnet/minecraft/client/gui/GuiGraphics;II)V"))
+    private boolean distractionFreeRecipes$drawTooltips(IIngredientListOverlayContents instance, Minecraft minecraft, GuiGraphics guiGraphics, int mouseX, int mouseY) {
+        return !distractionFreeRecipes$isHidden();
+    }
+
+    @WrapWithCondition(method = "drawOnForeground", at = @At(value = "INVOKE", target = "Lmezz/jei/gui/overlay/ingredients/IIngredientListOverlayContents;drawOnForeground(Lnet/minecraft/client/gui/GuiGraphics;II)V"))
+    private boolean distractionFreeRecipes$drawOnForeground(IIngredientListOverlayContents instance, GuiGraphics guiGraphics, int mouseX, int mouseY) {
+        return !distractionFreeRecipes$isHidden();
+    }
+
+    // Hidden ingredients must not be hoverable, or R/U/bookmark keys act on invisible slots.
+    @WrapOperation(
+        method = {
+            "getIngredientUnderMouse(DD)Ljava/util/stream/Stream;",
+            "getIngredientUnderMouse()Ljava/util/Optional;",
+            "getIngredientUnderMouse(Lmezz/jei/api/ingredients/IIngredientType;)Ljava/lang/Object;"
+        },
+        at = @At(value = "INVOKE", target = "Lmezz/jei/gui/overlay/ingredients/IIngredientListOverlayContents;getIngredientUnderMouse(DD)Ljava/util/stream/Stream;"),
+        require = 3
+    )
+    private Stream<?> distractionFreeRecipes$getIngredientUnderMouse(IIngredientListOverlayContents instance, double mouseX, double mouseY, Operation<Stream<?>> original) {
+        return distractionFreeRecipes$isHidden() ? Stream.empty() : original.call(instance, mouseX, mouseY);
+    }
+
+    @WrapOperation(method = "getDraggableIngredientUnderMouse", at = @At(value = "INVOKE", target = "Lmezz/jei/gui/overlay/ingredients/IIngredientListOverlayContents;getDraggableIngredientUnderMouse(DD)Ljava/util/stream/Stream;"))
+    private Stream<?> distractionFreeRecipes$getDraggableIngredientUnderMouse(IIngredientListOverlayContents instance, double mouseX, double mouseY, Operation<Stream<?>> original) {
+        return distractionFreeRecipes$isHidden() ? Stream.empty() : original.call(instance, mouseX, mouseY);
+    }
+}
+#else
 import mezz.jei.gui.elements.GuiIconToggleButton;
 import mezz.jei.gui.input.GuiTextFieldFilter;
 import mezz.jei.gui.overlay.IngredientGridWithNavigation;
@@ -60,4 +154,5 @@ public class JEIIngredientListOverlayMixin implements JEIAccessor {
     public boolean distractionFreeRecipes$isSearchEmpty() {
         return searchField.getValue().isEmpty();
     }
-}
\ No newline at end of file
+}
+#endif
