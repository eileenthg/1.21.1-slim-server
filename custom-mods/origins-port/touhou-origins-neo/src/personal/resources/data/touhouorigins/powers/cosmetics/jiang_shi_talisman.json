{
  "type": "apoli:multiple",
  "hidden": true,
  "variant": {
    "type": "apoli:resource",
    "min": 0,
    "max": 2
  },
  "assign": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:jiang_shi"
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "==",
          "compare_to": 0
        }
      ]
    },
    "entity_action": {
      "type": "apoli:choice",
      "actions": [
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 1
          }
        },
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 2
          }
        }
      ]
    }
  },
  "reset": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:jiang_shi",
          "inverted": true
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "!=",
          "compare_to": 0
        }
      ]
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "*:*_variant",
      "operation": "set",
      "change": 0
    }
  },
  "yoshika": {
    "type": "apoli:custom_model_render",
    "mode": "geometry",
    "model_location": "touhouorigins:tlm/jiang_shi_talisman",
    "texture_location": "touhouorigins:textures/entity/tlm/miyako_yoshika.png",
    "render_type": "cutout_no_cull",
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:jiang_shi"
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "==",
          "compare_to": 1
        }
      ]
    }
  },
  "qiqi": {
    "type": "apoli:custom_model_render",
    "mode": "geometry",
    "model_location": "touhouorigins:tlm/jiang_shi_talisman_qiqi",
    "texture_location": "touhouorigins:textures/entity/tlm/qiqi_talisman.png",
    "render_type": "cutout_no_cull",
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:jiang_shi"
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "==",
          "compare_to": 2
        }
      ]
    }
  }
}
