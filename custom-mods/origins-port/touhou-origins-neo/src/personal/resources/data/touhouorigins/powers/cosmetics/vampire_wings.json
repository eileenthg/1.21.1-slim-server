{
  "type": "apoli:multiple",
  "hidden": true,
  "variant": {
    "type": "apoli:resource",
    "min": 0,
    "max": 2
  },
  "assign": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:vampire"
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "==",
          "compare_to": 0
        }
      ]
    },
    "entity_action": {
      "type": "apoli:choice",
      "actions": [
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 1
          }
        },
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 2
          }
        }
      ]
    }
  },
  "reset": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:vampire",
          "inverted": true
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "!=",
          "compare_to": 0
        }
      ]
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "*:*_variant",
      "operation": "set",
      "change": 0
    }
  },
  "remilia": {
    "type": "apoli:custom_model_render",
    "mode": "geometry",
    "model_location": "touhouorigins:tlm/vampire_wings_remilia",
    "texture_location": "touhouorigins:textures/entity/tlm/remilia_scarlet.png",
    "render_type": "cutout_no_cull",
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:vampire"
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "==",
          "compare_to": 1
        }
      ]
    },
    "animations": [
      {
        "animation": "touhouorigins:cosmetics",
        "name": "animation.glide",
        "loop": true,
        "condition": {
          "type": "apoli:fall_flying"
        }
      },
      {
        "animation": "touhouorigins:cosmetics",
        "name": "animation.idle",
        "loop": true
      }
    ]
  },
  "flandre": {
    "type": "apoli:custom_model_render",
    "mode": "geometry",
    "model_location": "touhouorigins:tlm/vampire_wings_flandre",
    "texture_location": "touhouorigins:textures/entity/tlm/flandre_scarlet.png",
    "render_type": "cutout_no_cull",
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:vampire"
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "==",
          "compare_to": 2
        }
      ]
    },
    "animations": [
      {
        "animation": "touhouorigins:cosmetics",
        "name": "animation.glide",
        "loop": true,
        "condition": {
          "type": "apoli:fall_flying"
        }
      },
      {
        "animation": "touhouorigins:cosmetics",
        "name": "animation.idle",
        "loop": true
      }
    ]
  }
}
