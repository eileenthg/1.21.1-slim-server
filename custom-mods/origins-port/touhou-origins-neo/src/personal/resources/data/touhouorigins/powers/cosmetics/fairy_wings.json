{
  "type": "apoli:multiple",
  "hidden": true,
  "variant": {
    "type": "apoli:resource",
    "min": 0,
    "max": 5
  },
  "assign": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:fairy"
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "==",
          "compare_to": 0
        }
      ]
    },
    "entity_action": {
      "type": "apoli:choice",
      "actions": [
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 1
          }
        },
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 2
          }
        },
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 3
          }
        },
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 4
          }
        },
        {
          "weight": 1,
          "element": {
            "type": "apoli:change_resource",
            "resource": "*:*_variant",
            "operation": "set",
            "change": 5
          }
        }
      ]
    }
  },
  "reset": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:fairy",
          "inverted": true
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "!=",
          "compare_to": 0
        }
      ]
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "*:*_variant",
      "operation": "set",
      "change": 0
    }
  },
  "cirno": {
    "type": "apoli:custom_model_render",
    "mode": "geometry",
    "model_location": "touhouorigins:tlm/fairy_wings_cirno",
    "texture_location": "touhouorigins:textures/entity/tlm/cirno.png",
    "render_type": "cutout_no_cull",
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "touhouorigins:fairy"
        },
        {
          "type": "apoli:resource",
          "resource": "*:*_variant",
          "comparison": "==",
          "compare_to": 1
        }
      ]
    },
    "animations": [
      {
        "animation": "touhouorigins:cosmetics",
        "name": "animation.flutter",
        "loop": true,
        "condition": {
          "type": "apoli:and",
          "conditions": [
            {
              "type": "apoli:power_active",
              "power": "touhouorigins:fairy/fluttering_wings_toggle"
            },
            {
              "type": "apoli:on_block",
              "inverted": true
            }
          ]
        }
      },
      {
        "animation": "touhouorigins:cosmetics",
        "name": "animation.still",
        "loop": true
      }
    ]
  },
