          "type": "apoli:invert",
          "condition": {
            "type": "apoli:in_set",
            "set": "*:*_set"
          },
          "inverted": true
        }
      ]
    },
    "held_item_action": {
      "type": "apoli:consume"
    },
    "item_condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "apoli:ingredient",
          "ingredient": {
            "item": "minecraft:written_book"
