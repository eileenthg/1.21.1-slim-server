    },
    "condition": {
      "type": "apoli:resource",
      "resource": "*:*_boolean",
      "comparison": "==",
      "compare_to": 0
    }
  },
  "unlink": {
    "type": "touhouorigins:action_on_origin_gui",
    "entity_action": {
      "type": "apoli:and",
