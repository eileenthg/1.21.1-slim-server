{
  "type": "apoli:multiple",
  "water_protection": {
    "type": "apoli:resource",
    "min": 0,
    "max": 4
  },
  "track_water_protection": {
    "type": "apoli:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "touhouorigins:store_enchantment_level",
      "enchantment": "touhouorigins:water_protection",
      "resource": "*:*_water_protection",
      "calculation": "max"
    }
  },
  "flowing_water": {
    "type": "apoli:conditioned_attribute",
    "modifier": {
      "name": "Flowing water movement speed reduction",
      "attribute": "minecraft:generic.movement_speed",
      "operation": "multiply_total",
      "value": -0.7
    },
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "apoli:or",
          "conditions": [
            {
              "type": "apoli:block_in_radius",
              "block_condition": {
                "type": "apoli:and",
                "conditions": [
                  {
                    "type": "apoli:fluid",
                    "fluid_condition": {
                      "type": "apoli:still",
                      "inverted": true
                    }
                  },
                  {
                    "type": "apoli:block",
                    "block": "minecraft:water"
                  }
                ]
              },
              "radius": 0
            },
            {
              "type": "apoli:in_rain"
            }
          ]
        },
        {
          "type": "apoli:enchantment",
          "enchantment": "origins:water_protection",
          "calculation": "sum",
          "comparison": "<",
          "compare_to": 8
        }
      ]
    }
  },
  "more_fire_damage": {
    "type": "apoli:modify_damage_taken",
    "damage_condition": {
      "type": "apoli:fire"
    },
    "modifier": {
      "name": "More fire damage",
      "operation": "multiply_base",
      "value": 1
    }
  },
  "weak_to_gold": {
    "type": "apoli:modify_damage_taken",
    "damage_condition": {
      "type": "apoli:attacker",
      "entity_condition": {
        "type": "apoli:equipped_item",
        "equipment_slot": "mainhand",
        "item_condition": {
          "type": "apoli:ingredient",
          "ingredient": {
            "tag": "touhouorigins:golden_tools"
          }
        }
      }
    },
    "modifier": {
      "name": "Weakness to gold tools",
      "operation": "multiply_base",
      "value": 1
    }
  },
  "hurt_by_water": {
    "type": "apoli:action_over_time",
    "interval": 40,
    "onset_delay": "40 + touhouorigins:vampire/banes_of_the_immortal_water_protection * 30",
    "entity_action": {
      "type": "apoli:if_else",
      "condition": {
        "type": "apoli:difficulty",
        "difficulty": "easy"
      },
      "if_action": {
        "type": "apoli:damage",
        "amount": 0.5,
        "damage_type": "origins:hurt_by_water"
      },
      "else_action": {
        "type": "apoli:damage",
        "amount": 1,
