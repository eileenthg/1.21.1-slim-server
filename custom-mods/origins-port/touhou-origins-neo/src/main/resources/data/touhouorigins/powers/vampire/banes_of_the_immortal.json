        {
          "type": "apoli:in_rain"
        },
        {
          "type": "apoli:block_in_radius",
          "block_condition": {
            "type": "apoli:and",
            "conditions": [
              {
                "type": "apoli:fluid",
                "fluid_condition": {
                  "type": "apoli:still",
                  "inverted": true
                }
              },
              {
                "type": "apoli:block",
                "block": "minecraft:water"
              }
            ]
