{
  "type": "apoli:active_self",
  "entity_action": {
    "type": "apoli:raycast",
    "distance": 20,
    "block": false,
    "entity": true,
    "shape_type": "visual",
    "fluid_handling": "none",
    "bientity_condition": {
      "type": "apoli:target_condition",
      "condition": {
        "type": "apoli:entity_type",
        "entity_type": "minecraft:player"
      }
    },
    "bientity_action": {
      "type": "apoli:target_action",
      "action": {
        "type": "apoli:and",
        "actions": [
          {
            "type": "apoli:if_else",
            "condition": {
              "type": "origins:origin",
              "origin": "touhouorigins:satori_closed_eye"
            },
            "if_action": {
              "type": "apoli:execute_command",
              "command": "tellraw @s {\"translate\":\"power.touhouorigins.recollection.alert_fail\",\"color\":\"#A0DA81\"}"
            },
            "else_action": {
              "type": "apoli:execute_command",
              "command": "tellraw @s {\"translate\":\"power.touhouorigins.recollection.alert\",\"color\":\"#D02020\"}"
            }
          },
          {
            "type": "touhouorigins:store_origin_name",
            "storage": "touhouorigins:recollection",
            "path": "origin_name"
          }
        ]
      }
    },
    "miss_action": {
      "type": "apoli:delay",
      "ticks": 1,
      "action": {
        "type": "apoli:change_resource",
        "resource": "*:*",
        "change": 1200,
        "operation": "set"
      }
    },
    "command_at_hit": "function touhouorigins:recollection",
    "command_along_ray": "particle minecraft:witch",
    "command_step": 0.5,
    "command_along_ray_only_on_hit": true
  },
  "cooldown": 1200,
  "hud_render": {
    "sprite_location": "origins:textures/gui/sprites/hud_render/spiderkolo/resource_bar_02.png",
    "bar_index": 7
  },
  "key": {
    "key": "key.origins.primary_active"
  }
}
