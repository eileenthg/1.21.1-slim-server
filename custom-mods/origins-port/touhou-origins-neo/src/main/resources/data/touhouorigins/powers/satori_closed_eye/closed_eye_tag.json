{
  "type": "apoli:action_over_time",
  "hidden": true,
  "interval": 1,
  "rising_action": {
    "type": "apoli:execute_command",
    "command": "tag @s add touhouorigins.satori_closed_eye"
  },
  "falling_action": {
    "type": "apoli:execute_command",
    "command": "tag @s remove touhouorigins.satori_closed_eye"
  }
}
