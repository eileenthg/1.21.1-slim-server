+package net.brnbrd.delightful.common.mixin;
+
+import net.minecraft.world.inventory.ContainerData;
+import net.minecraft.world.level.block.entity.AbstractFurnaceBlockEntity;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.gen.Accessor;
+
+// Exposes the protected `dataAccess` field on AbstractFurnaceBlockEntity so FurnaceFuelItem
+// can read/mutate burn/cook time when a player right-clicks fuel directly onto a lit furnace.
+// Using a Mixin accessor instead of an access transformer sidesteps needing the SRG field id.
+@Mixin(AbstractFurnaceBlockEntity.class)
+public interface FurnaceDataAccessorAccessor {
+	@Accessor("dataAccess")
+	ContainerData delightful$getDataAccess();
+}
